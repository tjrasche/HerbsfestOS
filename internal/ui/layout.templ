package ui

templ Layout(title, activePage string) {
	<!DOCTYPE html>
	<html lang="de">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"responseHandling":[{"code":"204","swap":false},{"code":"422","swap":true},{"code":"[23]..","swap":true},{"code":"[45]..","swap":false,"error":true}]}'/>
			<title>{ title }</title>
			<meta name="theme-color" content="#0f4787"/>
			<link rel="icon" type="image/svg+xml" href="/static/brand/mascot.svg"/>
			<link rel="preload" href="/static/brand/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<a class="skip-link" href="#main">Zum Inhalt springen</a>
			<div class="app-shell">
				<aside class="sidebar" aria-label="Arbeitsbereich">
					<a class="brand" href="/" aria-label="Ringinger Herbstfest · Startseite">
						<span class="brand__mark"><img src="/static/brand/mascot.svg" width="48" height="48" alt=""/></span>
						<span class="brand__name">Ringinger<strong>Herbstfest<span class="brand__period">.</span></strong></span>
					</a>
					<div class="workspace-label"><span aria-hidden="true"></span>Unser Orga-Workspace</div>
					<nav class="navigation" aria-label="Hauptnavigation">
						<p class="navigation__label">Gemeinsam organisieren</p>
						<a class={ "nav-link", templ.KV("nav-link--active", activePage == "feedback") } href="/" aria-current={ activePageValue(activePage == "feedback") }>
							@Icon(IconFeedback)<span>Feedback</span><span class="nav-link__indicator" aria-hidden="true"></span>
						</a>
						<a class={ "nav-link", templ.KV("nav-link--active", activePage == "design-system") } href="/design-system" aria-current={ activePageValue(activePage == "design-system") }>
							@Icon(IconPalette)<span>Designsystem</span><span class="nav-link__indicator" aria-hidden="true"></span>
						</a>
					</nav>
					<div class="sidebar__bottom">
						<div class="sidebar__message"><span class="sidebar__motif" aria-hidden="true"></span><p>Ein Fest, das verbindet.</p><span>Ein Team, das es möglich macht.</span></div>
						<a class="sidebar__website" href="https://ringinger-herbstfest.de/" target="_blank" rel="noopener noreferrer">Unsere Fest-Website @Icon(IconExternal)<span class="sr-only">(öffnet in einem neuen Tab)</span></a>
					</div>
				</aside>
				<div class="workspace">
					<header class="topbar">
						<div class="breadcrumb"><span>Organisation</span><span class="breadcrumb__separator" aria-hidden="true">/</span><strong>{ sectionTitle(activePage) }</strong></div>
						<a class="topbar__link" href="https://ringinger-herbstfest.de/" target="_blank" rel="noopener noreferrer"><span>Ringinger Herbstfest</span>@Icon(IconExternal)<span class="sr-only">(öffnet in einem neuen Tab)</span></a>
					</header>
					<main id="main" class="main-content" tabindex="-1">{ children... }
</main>
					<footer class="workspace-footer">
						<div class="workspace-footer__signature"><strong>HerbstfestOS</strong><span>Mit Herz organisiert.</span></div>
						<a class="hosting-credit" href="https://rasche-thalhofer.cloud/" target="_blank" rel="noopener noreferrer">
							<span class="hosting-credit__logo"><img src="/static/brand/rasche-thalhofer.svg" width="30" height="31" alt="" loading="lazy"/></span>
							<span class="hosting-credit__copy">
								<span class="hosting-credit__thanks">Mit freundlicher Unterstützung durch</span>
								<span class="hosting-credit__company">Rasche &amp; Thalhofer <span>UG (haftungsbeschränkt)</span></span>
								<span class="hosting-credit__gift">Cloud geschenkt, damit ihr feiern könnt. @Icon(IconHeart)</span>
							</span>
							<span class="sr-only">(öffnet in einem neuen Tab)</span>
						</a>
					</footer>
				</div>
			</div>
			<div class="sr-only" id="app-status" role="status" aria-live="polite"></div>
		</body>
	</html>
}
