package ui

templ PublicPage() {
	@Layout("Ringinger Herbstfest", "public") {
				<img src="/static/brand/mascot.svg" width="80" height="80" alt=""/>
				@PageHeader("Ringinger Herbstfest", "Ein Fest, das verbindet.", "Schön, dass du da bist.")
				@Card("Gemeinsam feiern.", "Alle Informationen rund um unser Fest findest du auf unserer Fest-Website.") {
					@ButtonLink("Zur Fest-Website", "https://ringinger-herbstfest.de/", IconExternal, "primary")
					@ButtonLink("Zum Orga-Workspace", "/", IconArrowRight, "secondary")
				}
	}
}
