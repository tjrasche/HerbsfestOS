package scheduling

import "github.com/tjrasche/HerbsfestOS/internal/ui"

templ TeamListContent(v OrganisationPage, f FormState) {
	if len(v.Team)==0 {
		@ui.EmptyState("Standteam fehlt", "Ordnet mindestens ein Konto zu. Erst danach kann die Ausgabe aktiviert werden.")
	}
	<div class="record-list">
		for _,a:=range v.Team {
			<div class="record-row">
				<div><strong>{ a.Name }</strong><p class="muted">{ "Konto "+shortID(a.ID) }</p></div>
				<details>
					<summary>Teamzuordnung entfernen</summary>
					@ui.Form(orgPageURL(participationPath(v.Edition.ID, v.Participation.ID)+"/team/"+a.ID+"/remove", v.Shell)) {
						<p>{ a.Name+" verliert die Standorganisation für "+v.Participation.Name+" · "+v.Edition.Label+". Dauerhafte Helferzugehörigkeit bleibt erhalten." }</p>
						<label class="check-label"><input type="checkbox" name="confirm" value="true" required/> Entfernen für diese Ausgabe bestätigen</label>
						@ui.SubmitButton("Teamzuordnung entfernen", "Wird entfernt …", "danger")
					}
				</details>
			</div>
		}
	</div>
	if !accountIn(v.Team,v.Shell.AccountID)&&v.Shell.AccountID!="" {
		@ui.Form(orgPageURL(participationPath(v.Edition.ID, v.Participation.ID)+"/team", v.Shell)) {
			<input type="hidden" name="account_id" value={ v.Shell.AccountID }/>
			<p>Globaler Zugriff erlaubt die Ansicht. Für Dienstbearbeitung ist eine ausdrückliche Teamzuordnung nötig.</p>
			@ui.SubmitButton("Mich zum Standteam hinzufügen", "Wird zugeordnet …", "primary")
		}
	}
	@ui.GetForm(participationPath(v.Edition.ID, v.Participation.ID)) {
		@OrganisationQueryHidden(contextQuery(v.Shell))
		<label for="team-query">Konten suchen (Name oder Kontoreferenz)</label><input id="team-query" type="search" name="q" value={ v.Query } maxlength="200"/>
		@ui.SubmitButton("Konten suchen", "Wird gesucht …", "secondary")
	}
	if len(v.Accounts)>0 {
		@ui.Form(orgPageURL(participationPath(v.Edition.ID, v.Participation.ID)+"/team", v.Shell)) {
			<div class="field">
				<label for="team-account">Konto zum Standteam hinzufügen</label>
				<select name="account_id" id="team-account" required>
					<option value="">Konto auswählen</option>
					for _,a:=range v.Accounts {
						<option value={ a.ID } selected?={ f.Value("account_id","")==a.ID }>{ accountLabel(a) }</option>
					}
				</select>
			</div>
			<p class="muted">Bis zu 25 passende Konten. Bei Bedarf die Suche verfeinern.</p>
			@ui.SubmitButton("Zum Standteam hinzufügen", "Wird zugeordnet …", "secondary")
		}
	}
}
