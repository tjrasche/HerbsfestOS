# Explicit operator inputs for the first scheduling reconciliation.
# Leave legacy inputs empty when there are no unscoped feedback notes.
# Existing notes require all three values; missing inputs fail before writes.
# Never infer edition dates from CreatedAt or the current date.
LEGACY_EDITION_LABEL=
LEGACY_START_DAY=
LEGACY_END_DAY=
# Optional initial global organizer: validated OIDC issuer and subject only.
# Reconciliation applies this once and never restores a revoked grant.
# Supply both values together; do not use email/display-name matching.
BOOTSTRAP_ISSUER=
BOOTSTRAP_SUBJECT=
