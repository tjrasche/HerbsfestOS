# Export these variables in your shell; the application does not load .env files.
DATABASE_URL=postgres://herbsfest:herbsfest@localhost:5432/herbsfest?sslmode=disable
HTTP_ADDR=:8080

# Explicit bypass for local development only; the default without this is oidc.
AUTH_MODE=development

# To test SSO locally, create a separate Web/PKCE client with local redirect URIs.
# AUTH_MODE=oidc
# ZITADEL_ISSUER=https://auth.r-und-t.app
# APP_BASE_URL=http://localhost:8080
# ZITADEL_CLIENT_ID=your-local-client-id
# ZITADEL_PROJECT_ID=394051632024780961
# AUTH_SESSION_KEY=base64-encoded-32-random-bytes
# Generate a local key: openssl rand -base64 32
